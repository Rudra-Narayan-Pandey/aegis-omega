{
  "name": "AegisAgent Omega Workspace (Pure Python)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-zero-disk.sh",
  "remoteUser": "vscode"
}
